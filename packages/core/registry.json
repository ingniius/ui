{
  "$id": "https://vee-ui.com/schemas/registry.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Veehance UI Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "homepage"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema reference path"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Registry package name"
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Registry homepage URL"
    }
  }
}
